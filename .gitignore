# --- Secrets: never committed ---
# Any .env file (.env.local, .env.production, .env.backup ...) except the
# template, plus common key, certificate and credential file types.
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.secret
*.secrets
credentials*.json
secrets*.json
service-account*.json

# --- Python (backend) ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Node (frontend) ---
node_modules/
dist/
.vite/
*.local

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Stray git lock files (safe to ignore if ever regenerated) ---
.git/*.lock
*.lock.stale*

# --- Files the Claude desktop app syncs into this folder when it delivers
# a file to chat (reports, exports) -- not part of the app itself ---
Claude outputs/

# --- Endpoint test reports (contain Client IDs and store IDs, keep local) ---
backend/test-reports/

# --- Files moved aside for later deletion (this folder is never committed) ---
_to_delete/
