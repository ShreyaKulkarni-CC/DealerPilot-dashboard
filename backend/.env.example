# Copy to .env and fill in real values. Never commit the real .env, never
# paste real client_id/client_secret into chat -- fill this file in directly
# wherever it actually runs.
#
# Base URLs and the token endpoint are NOT needed here -- they're confirmed
# real values already hardcoded (non-secret) in app/config.py, chosen
# automatically based on ENVIRONMENT below.

ENVIRONMENT=sandbox

# --- vAuto (one shared Application credential covers both Appraisal and
# Inventory APIs -- confirmed from the real Applications screen, "Bridgeland
# Internal Deal Management Application") ---
# Use the Client ID / Client Secret shown when you expand the "Sandbox"
# section on that screen (the "Bridge 2" auth type row covers both vAuto
# APIs; Bridge 1 there is Xtime/servicescheduling, not needed here).
VAUTO_CLIENT_ID=
VAUTO_CLIENT_SECRET=

# Dealer entity to query. Leave blank on sandbox -- defaults automatically
# to the shared test dealer "EXT-TEST-01". Required on production.
VAUTO_ENTITY_LOGICAL_ID=

# --- Rapid Recon (on hold -- separate scope, task #3) ---
RAPIDRECON_CLIENT_ID=
RAPIDRECON_CLIENT_SECRET=
RAPIDRECON_TOKEN_URL=
RAPIDRECON_BASE_URL=
